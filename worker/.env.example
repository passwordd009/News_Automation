# Copy to .env and adjust. Never commit the real .env.

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///hestia_news.db

# --- Collectors --------------------------------------------------------------
ENABLE_RSS=true
ENABLE_GMAIL=false
ENABLE_NEWS_API=false

# Feeds live in config/rss_feeds.json. Point elsewhere with RSS_FEEDS_FILE,
# or override entirely with a comma-separated list in RSS_FEEDS.
# RSS_FEEDS_FILE=config/rss_feeds.json
# RSS_FEEDS=https://gothamist.com/feed,https://www.amny.com/feed/

HTTP_TIMEOUT=20
MAX_ARTICLES_PER_FEED=40
LOOKBACK_DAYS=2

# --- LLM (Phase 3) -----------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Scoring thresholds (Phase 4) --------------------------------------------
MIN_ARTICLE_SCORE=7
MIN_NYC_RELEVANCE=6
MIN_CREDIBILITY=6

# --- Weekly doc (Phase 6) ----------------------------------------------------
WEEKLY_MIN_ARTICLES=5
WEEKLY_MAX_ARTICLES=10

# Where local .txt copies of the Wrap-Up are written.
WEEKLY_OUTPUT_DIR=output

# Only needed for --google. OAuth client ID (Desktop app) from Google Cloud
# Console, with the Docs API and Drive API enabled on that project.
GOOGLE_CLIENT_SECRET_FILE=credentials.json
# Optional: drop the generated doc into a specific Drive folder.
# GOOGLE_DRIVE_FOLDER_ID=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
