# Copy to .env and adjust. Never commit the real .env.

# --- Supabase (the source of truth) ------------------------------------------
# Project Settings -> API in the Supabase dashboard.
# The service-role key BYPASSES Row Level Security. Keep it out of the frontend
# and out of git; the web app uses the anon key instead.
SUPABASE_URL=
# Called "secret" on newer projects, "service_role" on older ones. Either
# variable name works; set the one your dashboard shows.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Legacy SQLite -----------------------------------------------------------
# Only used by the deprecated Google Docs workflow in worker/legacy/.
DATABASE_URL=sqlite:///hestia_news.db

# --- Collectors --------------------------------------------------------------
ENABLE_RSS=true
ENABLE_GMAIL=false
ENABLE_NEWS_API=false

# Feeds live in config/rss_feeds.json. Point elsewhere with RSS_FEEDS_FILE,
# or override entirely with a comma-separated list in RSS_FEEDS.
# RSS_FEEDS_FILE=config/rss_feeds.json
# RSS_FEEDS=https://gothamist.com/feed,https://www.amny.com/feed/

HTTP_TIMEOUT=20
MAX_ARTICLES_PER_FEED=40
LOOKBACK_DAYS=2

# --- LLM ---------------------------------------------------------------------
# Only 'ollama' is implemented. Adding Claude/OpenAI/Gemini means registering a
# client in app/llm/client.py — no other module changes.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Seconds to wait for one review. Small local models on CPU can be slow.
LLM_TIMEOUT=120
# Low temperature: this is a scoring task, not a creative one.
LLM_TEMPERATURE=0.2
# Attempts per article. The retry adds a stricter "JSON only" instruction.
LLM_MAX_ATTEMPTS=2

# --- Scoring thresholds (Phase 4) --------------------------------------------
MIN_ARTICLE_SCORE=7
MIN_NYC_RELEVANCE=6
MIN_CREDIBILITY=6

# --- Weekly doc (Phase 6) ----------------------------------------------------
WEEKLY_MIN_ARTICLES=5
WEEKLY_MAX_ARTICLES=10

# Where local .txt copies of the Wrap-Up are written.
WEEKLY_OUTPUT_DIR=output

# Only needed for --google. OAuth client ID (Desktop app) from Google Cloud
# Console, with the Docs API and Drive API enabled on that project.
GOOGLE_CLIENT_SECRET_FILE=credentials.json
# Optional: drop the generated doc into a specific Drive folder.
# GOOGLE_DRIVE_FOLDER_ID=

# --- Editorial week ----------------------------------------------------------
# Weeks run Monday-Sunday. The week being posted stays active until Monday at
# 12:00 in this timezone, so it is still the active period while it goes out.
# Rotate with a Monday cron:  0 12 * * 1  python worker/scripts/rotate_week.py
TIMEZONE=America/New_York

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
